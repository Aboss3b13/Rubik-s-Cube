<Window x:Class="Rubik_s_Cube.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Rubik_s_Cube"
        mc:Ignorable="d"
        Title="Rubik's Cube" Height="800" Width="1300"
        MinHeight="650" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="#0D0D12"
        Foreground="#E8E8F0"
    FontFamily="Segoe UI Variable, Segoe UI"
    Loaded="MainWindow_Loaded">

    <Window.Resources>
        <!-- ═══════════════════════════════════════════ -->
        <!-- Modern Dark Gray Theme with Orange Accents  -->
        <!-- ═══════════════════════════════════════════ -->
        <Color x:Key="BgColor">#1E1E1E</Color>
        <Color x:Key="SidebarColor">#252526</Color>
        <Color x:Key="CardColor">#2D2D30</Color>
        <Color x:Key="CardHoverColor">#3E3E42</Color>
        <Color x:Key="SurfaceColor">#333337</Color>
        <Color x:Key="BorderColor">#3E3E42</Color>
        <Color x:Key="BorderHoverColor">#505050</Color>
        <Color x:Key="AccentColor">#FF8C00</Color>
        <Color x:Key="AccentHoverColor">#FFAA33</Color>
        <Color x:Key="AccentDimColor">#CC7000</Color>
        <Color x:Key="AccentGlowColor">#4D2A00</Color>
        <Color x:Key="VioletAccent">#FF6600</Color>
        <Color x:Key="TextPrimary">#F1F1F1</Color>
        <Color x:Key="TextSecondary">#B0B0B0</Color>
        <Color x:Key="TextMuted">#858585</Color>

        <SolidColorBrush x:Key="AppBackground" Color="{StaticResource BgColor}"/>
        <SolidColorBrush x:Key="PanelBackground" Color="{StaticResource SidebarColor}"/>
        <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
        <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource CardHoverColor}"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
        <SolidColorBrush x:Key="BorderHoverBrush" Color="{StaticResource BorderHoverColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
        <SolidColorBrush x:Key="AccentDimBrush" Color="{StaticResource AccentDimColor}"/>
        <SolidColorBrush x:Key="AccentGlowBrush" Color="{StaticResource AccentGlowColor}"/>
        <SolidColorBrush x:Key="VioletBrush" Color="{StaticResource VioletAccent}"/>
        <SolidColorBrush x:Key="TextForeground" Color="{StaticResource TextPrimary}"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}"/>

        <!-- Custom Scrollbar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#33FFFFFF" CornerRadius="3" Margin="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════ -->
        <!-- Move Button Style      -->
        <!-- ═══════════════════════ -->
        <Style x:Key="MoveButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextForeground}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource CardHoverBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentDimBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentGlowBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════ -->
        <!-- Scramble Button Style   -->
        <!-- ═══════════════════════ -->
        <Style x:Key="ScrambleButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#0D0D12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="border" CornerRadius="10" SnapsToDevicePixels="True">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="{StaticResource AccentColor}" Offset="0"/>
                                    <GradientStop Color="#E65c00" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="{StaticResource AccentHoverColor}" Offset="0"/>
                                            <GradientStop Color="#FF7A1A" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="{StaticResource AccentDimColor}" Offset="0"/>
                                            <GradientStop Color="#B34700" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Reset Button Style -->
        <Style x:Key="ResetButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="border" CornerRadius="10" Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BorderHoverBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextForeground}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource CardHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text Box Style -->
        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextForeground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Cascadia Code, Consolas"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource BorderHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="true">
                                <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Section Header Style -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="2,0,0,8"/>
        </Style>

        <!-- Perspective Button Style -->
        <Style x:Key="PerspectiveButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <TextBlock Text="{TemplateBinding Content}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#88FFFFFF"/>
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stat Label Style -->
        <Style x:Key="StatLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        </Style>
        <Style x:Key="StatValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Light"/>
            <Setter Property="Foreground" Value="{StaticResource TextForeground}"/>
            <Setter Property="FontFamily" Value="Cascadia Code, Consolas"/>
        </Style>

        <Style x:Key="SettingLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextForeground}"/>
        </Style>

        <Style x:Key="SettingValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontFamily" Value="Cascadia Code, Consolas"/>
        </Style>
    </Window.Resources>

    <Grid Name="MainGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════ -->
        <!-- Left Column: Sidebar Control Panel  -->
        <!-- ═══════════════════════════════════ -->
        <Border Grid.Column="0" Grid.RowSpan="2" SnapsToDevicePixels="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#13131A" Offset="0"/>
                    <GradientStop Color="#0F0F16" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="24,24,24,8">
                    <TextBlock Text="R U B I K ' S   C U B E" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextForeground}"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="3D Simulator" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                    <!-- Accent line -->
                    <Border Height="2" CornerRadius="1" Margin="0,4,0,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="{StaticResource AccentColor}" Offset="0"/>
                                <GradientStop Color="{StaticResource VioletAccent}" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </StackPanel>

                <!-- Scrollable Content -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,8,24,20">
                    <StackPanel>

                        <!-- Stats Card -->
                        <Border Background="{StaticResource CardBrush}" CornerRadius="12"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                Padding="16" Margin="0,8,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock Text="MOVES" Style="{StaticResource StatLabelStyle}" HorizontalAlignment="Center"/>
                                    <TextBlock Name="MoveCountText" Text="0" Style="{StaticResource StatValueStyle}" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <Border Grid.Column="1" Width="1" Background="{StaticResource BorderBrush}" Margin="8,4"/>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock Text="TIME" Style="{StaticResource StatLabelStyle}" HorizontalAlignment="Center"/>
                                    <TextBlock Name="TimerText" Text="0:00" Style="{StaticResource StatValueStyle}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Move Input Card -->
                        <Border Background="{StaticResource CardBrush}" CornerRadius="12"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="MOVE INPUT" Style="{StaticResource SectionHeaderStyle}"/>
                                <TextBox Name="MoveInput" KeyDown="MoveInput_KeyDown" Style="{StaticResource InputTextBoxStyle}"
                                         ToolTip="Type a move (e.g. R U R' U') and press Enter"/>
                            </StackPanel>
                        </Border>

                        <!-- Face Moves Card -->
                        <Border Background="{StaticResource CardBrush}" CornerRadius="12"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="FACE MOVES" Style="{StaticResource SectionHeaderStyle}"/>
                                <UniformGrid Columns="3" Margin="0,2,0,0">
                                    <Button Content="R" Style="{StaticResource MoveButtonStyle}" Click="MoveButton_Click"/>
                                    <Button Content="R'" Style="{StaticResource MoveButtonStyle}" Click="MoveButton_Click"/>
                                    <Button Content="R2" Style="{StaticResource MoveButtonStyle}" Click="MoveButton_Click"/>
                                    <Button Content="L" Style="{StaticResource MoveButtonStyle}" Click="MoveButton_Click"/>
                                    <Button Content="L'" Style="{StaticResource MoveButtonStyle}" Click="MoveButton_Click"/>
                                    <Button Content="L2" Style="{StaticResource MoveButtonStyle}" Click="MoveButton_Click"/>
                                    <Button Content="U" Style="{StaticResource MoveButtonStyle}" Click="MoveButton_Click"/>
                                    <Button Content="U'" Style="{StaticResource MoveButtonStyle}" Click="MoveButton_Click"/>
                                    <Button Content="U2" Style="{StaticResource MoveButtonStyle}" Click="MoveButton_Click"/>
                                    <Button Content="D" Style="{StaticResource MoveButtonStyle}" Click="MoveButton_Click"/>
                                    <Button Content="D'" Style="{StaticResource MoveButtonStyle}" Click="MoveButton_Click"/>
                                    <Button Content="D2" Style="{StaticResource MoveButtonStyle}" Click="MoveButton_Click"/>
                                    <Button Content="F" Style="{StaticResource MoveButtonStyle}" Click="MoveButton_Click"/>
                                    <Button Content="F'" Style="{StaticResource MoveButtonStyle}" Click="MoveButton_Click"/>
                                    <Button Content="F2" Style="{StaticResource MoveButtonStyle}" Click="MoveButton_Click"/>
                                    <Button Content="B" Style="{StaticResource MoveButtonStyle}" Click="MoveButton_Click"/>
                                    <Button Content="B'" Style="{StaticResource MoveButtonStyle}" Click="MoveButton_Click"/>
                                    <Button Content="B2" Style="{StaticResource MoveButtonStyle}" Click="MoveButton_Click"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- Slice + Rotation Card -->
                        <Border Background="{StaticResource CardBrush}" CornerRadius="12"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="SLICE MOVES" Style="{StaticResource SectionHeaderStyle}"/>
                                <UniformGrid Columns="3" Margin="0,2,0,8">
                                    <Button Content="M" Style="{StaticResource MoveButtonStyle}" Click="MoveButton_Click"/>
                                    <Button Content="M'" Style="{StaticResource MoveButtonStyle}" Click="MoveButton_Click"/>
                                    <Button Content="M2" Style="{StaticResource MoveButtonStyle}" Click="MoveButton_Click"/>
                                </UniformGrid>

                                <TextBlock Text="CUBE ROTATIONS" Style="{StaticResource SectionHeaderStyle}" Margin="2,6,0,8"/>
                                <UniformGrid Columns="3" Margin="0,2,0,8">
                                    <Button Content="x" ToolTip="Rotate around X axis" Style="{StaticResource MoveButtonStyle}" Click="CubeRotationButton_Click"/>
                                    <Button Content="x'" Style="{StaticResource MoveButtonStyle}" Click="CubeRotationButton_Click"/>
                                    <Button Content="x2" Style="{StaticResource MoveButtonStyle}" Click="CubeRotationButton_Click"/>
                                    <Button Content="y" ToolTip="Rotate around Y axis" Style="{StaticResource MoveButtonStyle}" Click="CubeRotationButton_Click"/>
                                    <Button Content="y'" Style="{StaticResource MoveButtonStyle}" Click="CubeRotationButton_Click"/>
                                    <Button Content="y2" Style="{StaticResource MoveButtonStyle}" Click="CubeRotationButton_Click"/>
                                    <Button Content="z" ToolTip="Rotate around Z axis" Style="{StaticResource MoveButtonStyle}" Click="CubeRotationButton_Click"/>
                                    <Button Content="z'" Style="{StaticResource MoveButtonStyle}" Click="CubeRotationButton_Click"/>
                                    <Button Content="z2" Style="{StaticResource MoveButtonStyle}" Click="CubeRotationButton_Click"/>
                                </UniformGrid>

                                <TextBlock Text="VIEW ROLL" Style="{StaticResource SectionHeaderStyle}" Margin="2,6,0,8"/>
                                <UniformGrid Columns="2">
                                    <Button Content="&#x21BB; CW" ToolTip="Roll 90 clockwise" Style="{StaticResource MoveButtonStyle}" Click="CubeRollButton_Click" Tag="CW"/>
                                    <Button Content="&#x21BA; CCW" ToolTip="Roll 90 counter-clockwise" Style="{StaticResource MoveButtonStyle}" Click="CubeRollButton_Click" Tag="CCW"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- Actions Card -->
                        <Border Background="{StaticResource CardBrush}" CornerRadius="12"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="ACTIONS" Style="{StaticResource SectionHeaderStyle}"/>
                                <Button Content="&#x27F3;  Scramble" Style="{StaticResource ScrambleButtonStyle}" Click="ScrambleButton_Click"/>
                                <Button Name="ResetButton" Content="Reset Cube" Style="{StaticResource ResetButtonStyle}" Click="ResetButton_Click"/>
                                <Button Name="SolveBeginnerButton" Content="Solve (Beginners)" Style="{StaticResource ResetButtonStyle}" Margin="0,5,0,0" Click="SolveBeginnerButton_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Perspective Card -->
                        <Border Background="{StaticResource CardBrush}" CornerRadius="12"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="PERSPECTIVE" Style="{StaticResource SectionHeaderStyle}"/>

                                <!-- Face Map -->
                                <Grid HorizontalAlignment="Center" Margin="0,6,0,12">
                                    <Grid.Resources>
                                        <Style TargetType="Border" x:Key="FaceBorderStyle">
                                            <Setter Property="Width" Value="38"/>
                                            <Setter Property="Height" Value="38"/>
                                            <Setter Property="CornerRadius" Value="6"/>
                                            <Setter Property="Margin" Value="2"/>
                                        </Style>
                                        <Style x:Key="FaceLabelStyle" TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="FontSize" Value="12"/>
                                            <Setter Property="Foreground" Value="#DD000000"/>
                                        </Style>
                                    </Grid.Resources>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Name="UpFace" Grid.Row="0" Grid.Column="1" Style="{StaticResource FaceBorderStyle}" Background="White">
                                        <TextBlock Text="U" Style="{StaticResource FaceLabelStyle}"/>
                                    </Border>
                                    <Border Name="LeftFace" Grid.Row="1" Grid.Column="0" Style="{StaticResource FaceBorderStyle}" Background="#FF8C00">
                                        <TextBlock Text="L" Style="{StaticResource FaceLabelStyle}"/>
                                    </Border>
                                    <Border Name="FrontFace" Grid.Row="1" Grid.Column="1" Style="{StaticResource FaceBorderStyle}" Background="#22C55E">
                                        <TextBlock Text="F" Style="{StaticResource FaceLabelStyle}"/>
                                    </Border>
                                    <Border Name="RightFace" Grid.Row="1" Grid.Column="2" Style="{StaticResource FaceBorderStyle}" Background="#EF4444">
                                        <TextBlock Text="R" Style="{StaticResource FaceLabelStyle}"/>
                                    </Border>
                                    <Border Name="DownFace" Grid.Row="2" Grid.Column="1" Style="{StaticResource FaceBorderStyle}" Background="#FACC15">
                                        <TextBlock Text="D" Style="{StaticResource FaceLabelStyle}"/>
                                    </Border>
                                    <Border Name="BackFace" Grid.Row="3" Grid.Column="1" Style="{StaticResource FaceBorderStyle}" Background="#3B82F6">
                                        <TextBlock Text="B" Style="{StaticResource FaceLabelStyle}"/>
                                    </Border>
                                </Grid>

                                <!-- Color Selectors -->
                                <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,4">
                                    <Button Content="W" Background="White" Style="{StaticResource PerspectiveButtonStyle}" Click="SwitchPerspective_Click"/>
                                    <Button Content="Y" Background="#FACC15" Style="{StaticResource PerspectiveButtonStyle}" Click="SwitchPerspective_Click"/>
                                    <Button Content="G" Background="#22C55E" Style="{StaticResource PerspectiveButtonStyle}" Click="SwitchPerspective_Click"/>
                                    <Button Content="B" Background="#3B82F6" Style="{StaticResource PerspectiveButtonStyle}" Click="SwitchPerspective_Click"/>
                                    <Button Content="R" Background="#EF4444" Style="{StaticResource PerspectiveButtonStyle}" Click="SwitchPerspective_Click"/>
                                    <Button Content="O" Background="#FF8C00" Style="{StaticResource PerspectiveButtonStyle}" Click="SwitchPerspective_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Settings Card -->
                        <Border Background="{StaticResource CardBrush}" CornerRadius="12"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="SETTINGS" Style="{StaticResource SectionHeaderStyle}"/>

                                <StackPanel Margin="0,2,0,10">
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="Sticker gloss" Style="{StaticResource SettingLabelStyle}" DockPanel.Dock="Left"/>
                                        <TextBlock Name="GlossValueText" Text="24" Style="{StaticResource SettingValueStyle}" DockPanel.Dock="Right"/>
                                    </DockPanel>
                                    <Slider Name="GlossSlider" Minimum="0" Maximum="40" Value="24"
                                            TickFrequency="4" IsSnapToTickEnabled="False"
                                            ValueChanged="GlossSlider_ValueChanged"/>
                                </StackPanel>

                                <CheckBox Name="GlossToggle" Content="Enable gloss" IsChecked="True"
                                          Foreground="{StaticResource TextForeground}"
                                          Margin="0,0,0,10"
                                          Checked="GlossToggle_Checked"
                                          Unchecked="GlossToggle_Unchecked"/>

                                <StackPanel Margin="0,0,0,10">
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="Gap between cubies" Style="{StaticResource SettingLabelStyle}" DockPanel.Dock="Left"/>
                                        <TextBlock Name="GapValueText" Text="0.02" Style="{StaticResource SettingValueStyle}" DockPanel.Dock="Right"/>
                                    </DockPanel>
                                    <Slider Name="GapSlider" Minimum="0.00" Maximum="0.08" Value="0.02"
                                            TickFrequency="0.01" IsSnapToTickEnabled="False"
                                            ValueChanged="GapSlider_ValueChanged"/>
                                </StackPanel>

                                <StackPanel>
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="Animation speed" Style="{StaticResource SettingLabelStyle}" DockPanel.Dock="Left"/>
                                        <TextBlock Name="SpeedValueText" Text="1.0x" Style="{StaticResource SettingValueStyle}" DockPanel.Dock="Right"/>
                                    </DockPanel>
                                    <Slider Name="SpeedSlider" Minimum="0.5" Maximum="2.0" Value="1.0"
                                            TickFrequency="0.1" IsSnapToTickEnabled="False"
                                            ValueChanged="SpeedSlider_ValueChanged"/>
                                </StackPanel>

                                <Border Height="1" Margin="0,14,0,14" Background="{StaticResource BorderBrush}" Opacity="0.7"/>

                                <TextBlock Text="LIGHTING" Style="{StaticResource SectionHeaderStyle}" Margin="2,0,0,8"/>

                                <StackPanel Margin="0,0,0,10">
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="Ambient light" Style="{StaticResource SettingLabelStyle}" DockPanel.Dock="Left"/>
                                        <TextBlock Name="AmbientValueText" Text="50" Style="{StaticResource SettingValueStyle}" DockPanel.Dock="Right"/>
                                    </DockPanel>
                                    <Slider Name="AmbientSlider" Minimum="0" Maximum="255" Value="50"
                                            TickFrequency="25" IsSnapToTickEnabled="False"
                                            ValueChanged="AmbientSlider_ValueChanged"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,10">
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="Key light" Style="{StaticResource SettingLabelStyle}" DockPanel.Dock="Left"/>
                                        <TextBlock Name="KeyLightValueText" Text="255" Style="{StaticResource SettingValueStyle}" DockPanel.Dock="Right"/>
                                    </DockPanel>
                                    <Slider Name="KeyLightSlider" Minimum="0" Maximum="255" Value="255"
                                            TickFrequency="25" IsSnapToTickEnabled="False"
                                            ValueChanged="KeyLightSlider_ValueChanged"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,10">
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="Fill light" Style="{StaticResource SettingLabelStyle}" DockPanel.Dock="Left"/>
                                        <TextBlock Name="FillLightValueText" Text="150" Style="{StaticResource SettingValueStyle}" DockPanel.Dock="Right"/>
                                    </DockPanel>
                                    <Slider Name="FillLightSlider" Minimum="0" Maximum="255" Value="150"
                                            TickFrequency="25" IsSnapToTickEnabled="False"
                                            ValueChanged="FillLightSlider_ValueChanged"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,10">
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="Rim light" Style="{StaticResource SettingLabelStyle}" DockPanel.Dock="Left"/>
                                        <TextBlock Name="RimLightValueText" Text="90" Style="{StaticResource SettingValueStyle}" DockPanel.Dock="Right"/>
                                    </DockPanel>
                                    <Slider Name="RimLightSlider" Minimum="0" Maximum="255" Value="90"
                                            TickFrequency="25" IsSnapToTickEnabled="False"
                                            ValueChanged="RimLightSlider_ValueChanged"/>
                                </StackPanel>

                                <CheckBox Name="RimLightToggle" Content="Enable rim light" IsChecked="True"
                                          Foreground="{StaticResource TextForeground}"
                                          Margin="0,0,0,0"
                                          Checked="RimLightToggle_Checked"
                                          Unchecked="RimLightToggle_Unchecked"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Sidebar divider line -->
        <Border Grid.Column="0" Grid.RowSpan="2" HorizontalAlignment="Right" Width="1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00FFFFFF" Offset="0"/>
                    <GradientStop Color="#18FFFFFF" Offset="0.3"/>
                    <GradientStop Color="#18FFFFFF" Offset="0.7"/>
                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- ═══════════════════════════════════ -->
        <!-- Right Column: 3D Viewport Area      -->
        <!-- ═══════════════════════════════════ -->
        <Grid Grid.Column="1" Grid.Row="0" Margin="16">
            <!-- Subtle radial glow behind cube -->
            <Border CornerRadius="16">
                <Border.Background>
                    <RadialGradientBrush Center="0.5,0.5" RadiusX="0.6" RadiusY="0.6">
                        <GradientStop Color="#08FFFFFF" Offset="0"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>

            <!-- Viewport frame -->
            <Border CornerRadius="16" BorderThickness="1" ClipToBounds="True">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#22FFFFFF" Offset="0"/>
                        <GradientStop Color="#08FFFFFF" Offset="0.5"/>
                        <GradientStop Color="#18FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.Background>
                    <RadialGradientBrush Center="0.5,0.45" RadiusX="0.8" RadiusY="0.8">
                        <GradientStop Color="#161622" Offset="0"/>
                        <GradientStop Color="#0D0D12" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>

                <Grid>
                    <Viewport3D Name="MyViewport"
                                MouseDown="MyViewport_MouseDown"
                                MouseMove="MyViewport_MouseMove"
                                MouseUp="MyViewport_MouseUp">
                        <Viewport3D.Camera>
                            <PerspectiveCamera x:Name="Camera" Position="5,5,5" LookDirection="-5,-5,-5" UpDirection="0,1,0" FieldOfView="60"/>
                        </Viewport3D.Camera>
                        <ModelVisual3D>
                            <ModelVisual3D.Content>
                                <Model3DGroup>
                                    <AmbientLight Color="#7F7F7F"/>
                                    <DirectionalLight Color="#AAAAAA" Direction="-1,-1,-1"/>
                                    <DirectionalLight Color="#AAAAAA" Direction="1,-2,-1"/>
                                    <DirectionalLight Color="#AAAAAA" Direction="1,1,1"/>
                                </Model3DGroup>
                            </ModelVisual3D.Content>
                        </ModelVisual3D>
                    </Viewport3D>

                    <!-- Drag hint overlay -->
                    <TextBlock Text="Click and drag to rotate"
                               HorizontalAlignment="Center" VerticalAlignment="Bottom"
                               Margin="0,0,0,16" FontSize="11"
                               Foreground="#33FFFFFF"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════ -->
        <!-- Bottom Status Bar                    -->
        <!-- ═══════════════════════════════════ -->
        <Border Grid.Column="1" Grid.Row="1" Margin="16,0,16,12">
            <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="20,10"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Name="StatusText" Text="Ready" VerticalAlignment="Center"
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Last: " FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                        <TextBlock Name="LastMoveText" Text="&#x2014;" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}" FontFamily="Cascadia Code, Consolas"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
